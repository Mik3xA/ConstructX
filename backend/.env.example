PORT=3000
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h
DB_PATH=./dev.db
CORS_ORIGIN=http://localhost:4200
# Puntos porcentuales de tolerancia para la alerta naranja (regla de negocio: 5)
ALERTA_TOLERANCIA=5
# Intervalo del auditor periódico en minutos (0 = desactivado)
ALERTA_INTERVALO_MIN=15

# ---------- Fletes (MXN) ----------
FLETE_BASE=450
FLETE_PORCENTAJE=0.03
FLETE_GRATIS_DESDE=25000

# ---------- Correo (Nodemailer) ----------
# Sin SMTP_HOST, los recibos NO se envían: se guardan como HTML en MAIL_DIR para revisarlos.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ConstructX <no-reply@constructx.mx>
MAIL_DIR=./correos
